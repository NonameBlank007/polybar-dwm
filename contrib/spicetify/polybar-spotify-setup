#!/usr/bin/env python3
"""
Install / update Polybar's Spotify lyrics bridge for Spicetify.
Enables official Spotify synced lyrics in Polybar without external scraping.
"""

import os
import sys
import shutil
import subprocess
from pathlib import Path

EXTENSION_NAME = "polybar-lyrics.js"

def show_help():
    print("""Usage: polybar-spotify-setup [OPTIONS]

Install and configure the Polybar lyrics integration extension for Spicetify.

Options:
  -h, --help       Show this help message and exit
  -u, --uninstall  Disable and remove the extension from Spicetify
""")

def main():
    if "-h" in sys.argv or "--help" in sys.argv:
        show_help()
        sys.exit(0)

    spicetify = shutil.which("spicetify")
    if not spicetify:
        print("Error: Spicetify is not installed or not in PATH.", file=sys.stderr)
        sys.exit(1)

    result = subprocess.run([spicetify, "-c"], check=True, text=True, capture_output=True)
    config_file = Path(result.stdout.strip())
    extensions_dir = config_file.parent / "Extensions"
    extensions_dir.mkdir(parents=True, exist_ok=True)
    target_file = extensions_dir / EXTENSION_NAME

    if "-u" in sys.argv or "--uninstall" in sys.argv:
        print("Disabling extension in Spicetify...")
        subprocess.run([spicetify, "config", "extensions", f"{EXTENSION_NAME}-"], check=False)
        if target_file.exists():
            target_file.unlink()
            print(f"Removed {target_file}")
        print("Applying Spicetify changes...")
        subprocess.run([spicetify, "apply"], check=True)
        print("✓ Polybar Spotify lyrics extension uninstalled successfully.")
        sys.exit(0)

    candidates = [
        Path(__file__).resolve().parent / EXTENSION_NAME,
        Path("/usr/local/share/polybar/spicetify") / EXTENSION_NAME,
        Path("/usr/share/polybar/spicetify") / EXTENSION_NAME,
        Path.home() / ".local/share/polybar/spicetify" / EXTENSION_NAME,
        Path.home() / ".config/polybar/scripts" / EXTENSION_NAME,
    ]
    script_source = None
    for cand in candidates:
        if cand.exists():
            script_source = cand
            break

    if not script_source:
        print(f"Error: {EXTENSION_NAME} not found in candidate paths:", file=sys.stderr)
        for cand in candidates:
            print(f"  - {cand}", file=sys.stderr)
        sys.exit(1)

    shutil.copy2(script_source, target_file)
    print(f"Copied {EXTENSION_NAME} to {target_file}")

    print("Enabling extension in Spicetify...")
    subprocess.run([spicetify, "config", "extensions", EXTENSION_NAME], check=True)

    print("Applying Spicetify changes...")
    subprocess.run([spicetify, "apply"], check=True)
    print("\n✓ Polybar Spotify lyrics bridge installed and applied successfully!")

if __name__ == "__main__":
    main()
